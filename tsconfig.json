{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "declarationDir": "./dist/types",
    "target": "ES2020",
    "lib": ["es2020"],

    "module": "nodenext",
    "moduleResolution": "nodenext",

    "strict": true,

    "esModuleInterop": true,

    "declaration": true,
    "declarationMap": true,

    "sourceMap": true,

    "emitDeclarationOnly": false,

    "types": ["node", "jest"],

    "resolveJsonModule": true
  },
  "include": ["lib/**/*.ts"]
}
